<div id="flash">
  <% if flash.any? %>
    <div class="container mx-auto mt-6 px-5">
      <% flash.each do |type, messages| %>
        <% Array(messages).each_with_index do |message, index| %>
          <%= render "application/flash", type: type.to_s, message: message, index: index %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>